<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron JIT compiler -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for native Node addons (uiohook-napi, naudiodon) loaded at runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for dynamically loaded native modules not signed by Apple -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice dictation: microphone capture -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- AppleScript-based auto-paste (System Events keystroke) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
