{
  "name": "my-wisper-emotion-frontend",
  "version": "1.0.0",
  "main": "dist/electron/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "postinstall": "electron-rebuild",
    "rebuild": "electron-rebuild",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --external:electron --external:naudiodon --external:onnxruntime-node --external:uiohook-napi --outfile=dist/electron/main.js && esbuild electron/preload.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/electron/preload.js && esbuild electron/textInjector.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/electron/textInjector.js",
    "build": "vite build && bun run build:electron",
    "dist": "electron-builder",
    "dev": "concurrently \"vite\" \"sleep 3 && bun run build:electron && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\""
  },
  "build": {
    "appId": "com.wisper.emotion",
    "productName": "Wisper Emotion",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "Wisper-Emotion-${version}-arm64.dmg"
    },
    "dmg": {
      "title": "Wisper Emotion ${version}"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "sidecar/**",
          "models/vad/**",
          "models/emotion/config.json",
          "models/emotion/preprocessor_config.json",
          "models/emotion/preprocessor/**",
          "whisper.cpp/build/Release/addon.node",
          "node_modules/**",
          "package.json"
        ]
      }
    ]
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.5"
  }
}
