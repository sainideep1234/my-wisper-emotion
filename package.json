{
  "name": "wisper-emotion",
  "version": "1.1.0",
  "private": true,
  "main": "packages/desktop/dist/electron/main.js",
  "scripts": {
    "postinstall": "bash scripts/fix-naudiodon-portaudio.sh",
    "build:whisper-addon": "bash scripts/build-whisper-addon.sh",
    "build:paste-helper": "mkdir -p bin packages/desktop/bin && clang -O2 -framework ApplicationServices packages/desktop/electron/native/paste.c -o bin/paste-helper && cp bin/paste-helper packages/desktop/bin/paste-helper",
    "build:fn-poll": "mkdir -p bin packages/desktop/bin && clang -O2 -framework ApplicationServices packages/desktop/electron/native/fn-poll.c -o bin/fn-poll && cp bin/fn-poll packages/desktop/bin/fn-poll",
    "rebuild:electron": "bunx @electron/rebuild -f && cd packages/desktop && bunx @electron/rebuild -f",
    "setup": "bun install && bun run build:whisper-addon && bun run build:paste-helper && bun run build:fn-poll && cd packages/desktop && bun install && cd .. && bash scripts/fix-naudiodon-portaudio.sh && bun run rebuild:electron",
    "dev": "cd packages/desktop && bun run dev",
    "build:desktop": "cd packages/desktop && bun run build",
    "release:mac": "rm -rf release && bun run build:desktop && STRICT=1 bash scripts/fix-naudiodon-portaudio.sh && bash scripts/stage-whisper-runtime.sh && bash scripts/preflight-package.sh && bunx electron-builder --mac --publish never && bash scripts/verify-native-modules.sh",
    "publish:release": "bash scripts/publish-release.sh"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.wisper.emotion",
    "productName": "Wisper",
    "afterPack": "scripts/after-pack-sign.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "packages/desktop/dist/**/*",
      "package.json",
      "!node_modules/naudiodon/**/*",
      "!node_modules/segfault-handler/**/*",
      "!node_modules/bindings/**/*",
      "!node_modules/file-uri-to-path/**/*",
      "!node_modules/onnxruntime-node/**/*",
      "!node_modules/onnxruntime-common/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib"
    ],
    "extraResources": [
      {
        "from": "build/whisper-runtime",
        "to": "whisper.cpp/build/Release"
      },
      {
        "from": "packages/desktop/node_modules/uiohook-napi",
        "to": "node_modules/uiohook-napi"
      },
      {
        "from": "packages/desktop/node_modules/node-gyp-build",
        "to": "node_modules/node-gyp-build"
      },
      {
        "from": "packages/desktop/node_modules/naudiodon",
        "to": "node_modules/naudiodon"
      },
      {
        "from": "packages/desktop/node_modules/segfault-handler",
        "to": "node_modules/segfault-handler"
      },
      {
        "from": "packages/desktop/node_modules/onnxruntime-node",
        "to": "node_modules/onnxruntime-node",
        "filter": [
          "**/*",
          "!bin/napi-v6/linux/**",
          "!bin/napi-v6/win32/**",
          "!script/**"
        ]
      },
      {
        "from": "packages/desktop/node_modules/onnxruntime-common",
        "to": "node_modules/onnxruntime-common"
      },
      {
        "from": "packages/desktop/node_modules/bindings",
        "to": "node_modules/bindings"
      },
      {
        "from": "packages/desktop/node_modules/file-uri-to-path",
        "to": "node_modules/file-uri-to-path"
      },
      {
        "from": "packages/desktop/bin/fn-poll",
        "to": "bin/fn-poll"
      },
      {
        "from": "packages/desktop/bin/paste-helper",
        "to": "bin/paste-helper"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electron-builder": "^24.13.3",
    "electron": "^43.2.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/naudiodon": "^2.2.5",
    "naudiodon": "^2.3.6"
  }
}
